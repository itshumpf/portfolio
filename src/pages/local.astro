---
// src/pages/local.astro  →  /local
// Standalone landing page for the printed card's QR code.
// Deliberately does NOT use the site Layout: no nav, no footer links,
// nothing on the page competing with the call button.

const phone        = "+19135854310";
const phoneDisplay = "(913) 585-4310";
const email        = "braeden@thekeenas.com";

const mailtoBody = [
  "What's going on:",
  "",
  "Where you are:",
  "",
  "Best number to reach you:",
  "",
].join("\n");

const mailto = `mailto:${email}?subject=${encodeURIComponent(
  "Help with my business"
)}&body=${encodeURIComponent(mailtoBody)}`;

const title = "Braeden Keena — Small business technology · Overland Park, KS";
const description =
  "Websites, online ordering, card readers, Wi-Fi, email, cameras, backups. " +
  "One person for the whole technology side of your business. " +
  `Overland Park, KS. ${phoneDisplay}`;

const terms = [
  ["First look at it",          "Free · 15 min"],
  ["A number before any work",  "Always"],
  ["Open-ended hourly meter",   "Never"],
  ["Evenings & weekends",       "Yes"],
  ["Contracts or retainers",    "Not required"],
];

const groups = [
  {
    n: "01",
    title: "Get you online",
    items: [
      "Websites built from scratch — fast, mobile, yours to keep",
      "Fixing or taking over the site you already have",
      "Online ordering and menus that stay current",
      "Google Business Profile, maps, and reviews",
      "Domains, hosting, and business email",
    ],
  },
  {
    n: "02",
    title: "Get you paid",
    items: [
      "Card readers and point of sale — set up, moved, or fixed",
      "Square, Toast, Clover, Stripe and the rest",
      "Taking payments through your website",
      "Receipt and kitchen printers that stop printing",
      "Invoicing that goes out without you chasing it",
    ],
  },
  {
    n: "03",
    title: "Keep it running",
    items: [
      "Wi-Fi that drops, dead spots, guest networks",
      "Email and Microsoft 365, including the locked-out account",
      "New computers set up, old ones moved over",
      "Backups that actually restore when you need them",
      "Cameras, recorders, watching the place from your phone",
      "Networks, access points, cable runs",
    ],
  },
  {
    n: "04",
    title: "Make it easier",
    items: [
      "The spreadsheet you retype every week — automated",
      "Reports that build themselves",
      "Getting two systems to talk to each other",
      "Scheduling, reminders, and follow-ups on autopilot",
    ],
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#150826" />
  <link rel="canonical" href="https://braedenkeena.pages.dev/local" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
</head>
<body>
<div class="sheet">

  <div class="hero">
    <span class="lbl">Small business technology &nbsp;·&nbsp; Overland Park</span>
    <h1 class="name">Braeden Keena</h1>
    <p class="tagline">Your website, your card reader, your Wi-Fi. <em>One number.</em></p>
    <p class="oneline">One person, not an agency — so you get the same guy every time, and he already knows your setup.</p>

    <a class="btn" href={`tel:${phone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
      Call {phoneDisplay}
    </a>
    <div class="alts">
      <a class="btn ghost" href={`sms:${phone}`}>Text</a>
      <a class="btn ghost" href={mailto}>Email</a>
    </div>
  </div>

  <div class="block">
    <span class="lbl">Terms — plainly</span>
    <dl>
      {terms.map(([label, value]) => (
        <div class="row">
          <dt>{label}</dt><span class="leader" /><dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="block">
    <span class="lbl">What I do</span>
    <div class="groups">
      {groups.map((g) => (
        <div class="grp">
          <h3><span>{g.n}</span> {g.title}</h3>
          <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>

    <p class="anything"><b>Not on the list?</b> Ask anyway. If it plugs in, logs in, or takes a payment, it's probably something I can sort out — and if it isn't, I'll tell you that for free.</p>
  </div>

  <div class="block creds">
    <span class="lbl">Bigger than a service call?</span>
    <p>Local support is half of what I do. The other half is building things — public-records pipelines, national pricing trackers, custom dashboards, embedded hardware. If you've got a project rather than a problem, the technical work is all written up.</p>
    <a href="/">See the technical portfolio
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>

  <footer>
    <b>Braeden Keena</b> · Overland Park, Kansas<br />
    <a href={`mailto:${email}`} style="color:inherit">{email}</a><br />
    Johnson County &amp; greater Kansas City ·
    <a href={`tel:${phone}`} style="color:inherit;white-space:nowrap">{phoneDisplay}</a>
  </footer>
</div>

</body>
</html>

<style is:global>

  :root{
    --bg:#150826; --ink:#f5f2f9; --dim:#b1a2c8; --accent:#c9a4ff;
    --hair:rgba(201,164,255,.16); --rule:rgba(201,164,255,.34); --white:#fdfcff;
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}
  body{
    background:var(--bg); color:var(--ink);
    font:400 16.5px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  body::before{
    content:""; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.5;
    background-image:
      radial-gradient(1px 1px at 12% 18%,#fff 50%,transparent 51%),
      radial-gradient(1px 1px at 68% 9%,#e6d6ff 50%,transparent 51%),
      radial-gradient(1px 1px at 33% 47%,#fff 50%,transparent 51%),
      radial-gradient(1px 1px at 88% 38%,#d9c4ff 50%,transparent 51%),
      radial-gradient(1px 1px at 51% 72%,#fff 50%,transparent 51%),
      radial-gradient(1px 1px at 21% 88%,#e6d6ff 50%,transparent 51%),
      radial-gradient(1px 1px at 79% 81%,#fff 50%,transparent 51%),
      radial-gradient(1px 1px at 5% 62%,#d9c4ff 50%,transparent 51%),
      radial-gradient(1px 1px at 94% 60%,#fff 50%,transparent 51%),
      radial-gradient(1px 1px at 43% 27%,#cbb2ff 50%,transparent 51%);
    background-size:330px 330px;
  }
  .sheet{position:relative; z-index:1; max-width:620px; margin:0 auto; padding:0 20px}
  .lbl{font:600 10.5px/1 var(--mono); letter-spacing:.17em; text-transform:uppercase}

  .top{
    display:flex; justify-content:space-between; align-items:baseline; gap:12px;
    padding:15px 0 12px; border-bottom:2px solid var(--rule); color:var(--ink);
  }
  .top .r{color:var(--dim)}

  /* ---------- hero ---------- */
  .hero{padding:30px 0 24px; border-bottom:2px solid var(--rule)}
  .hero .lbl{color:var(--accent); display:block; margin-bottom:13px}
  .name{
    display:block; color:var(--white);
    font-size:clamp(36px,10.6vw,58px); line-height:.98; font-weight:800;
    letter-spacing:-.035em;
  }
  .tagline{
    margin-top:19px; font-size:20px; line-height:1.32; font-weight:650;
    letter-spacing:-.017em; max-width:24ch; color:var(--white);
  }
  .tagline em{font-style:normal; color:var(--accent)}
  .oneline{margin-top:13px; font-size:15.5px; color:var(--dim); max-width:36ch}
  .btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    margin-top:22px; min-height:60px; border-radius:13px;
    background:var(--white); color:#1a0b2e; text-decoration:none;
    font-size:19px; font-weight:800; letter-spacing:-.01em;
    box-shadow:0 12px 32px -14px rgba(201,164,255,.75);
  }
  .btn.ghost{
    margin-top:0; background:rgba(255,255,255,.04); color:var(--ink);
    border:1px solid var(--rule); min-height:52px; font-size:16.5px; font-weight:650; box-shadow:none;
  }
  .alts{display:grid; grid-template-columns:1fr 1fr; gap:9px; margin-top:9px}
  .btn svg{width:18px;height:18px;flex:none}

  /* ---------- blocks ---------- */
  .block{padding:26px 0; border-bottom:2px solid var(--rule)}
  .block:last-of-type{border-bottom:0}
  .block > .lbl{color:var(--accent); display:block; margin-bottom:17px}

  .row{display:flex; align-items:baseline; gap:8px; padding:11px 0; border-bottom:1px solid var(--hair)}
  .row:last-child{border-bottom:0}
  .row dt{font-size:16px; font-weight:600; white-space:nowrap}
  .leader{flex:1; border-bottom:1.5px dotted var(--hair); transform:translateY(-4px)}
  .row dd{font:600 12.5px/1 var(--mono); letter-spacing:.06em; text-transform:uppercase; color:var(--accent); white-space:nowrap}

  /* ---------- capability groups ---------- */
  .grp{margin-bottom:22px}
  .grp:last-child{margin-bottom:0}
  .grp h3{
    font-size:17.5px; font-weight:750; letter-spacing:-.015em; color:var(--white);
    padding-bottom:9px; margin-bottom:10px; border-bottom:1px solid var(--rule);
    display:flex; align-items:baseline; gap:9px;
  }
  .grp h3 span{font:600 10.5px/1 var(--mono); letter-spacing:.16em; color:var(--accent); opacity:.8}
  .grp ul{list-style:none; display:grid; gap:7px}
  .grp li{
    display:grid; grid-template-columns:14px 1fr; gap:10px; align-items:start;
    font-size:15.8px; line-height:1.42; color:var(--ink);
  }
  .grp li::before{
    content:""; width:5px; height:5px; margin-top:8px; border-radius:50%;
    background:var(--accent); opacity:.75;
  }
  .anything{
    margin-top:20px; padding:15px 16px; border:1px dashed var(--rule); border-radius:12px;
    font-size:15.5px; color:var(--dim); line-height:1.5;
  }
  .anything b{color:var(--white); font-weight:650}

  /* ---------- credentials strip ---------- */
  .creds p{font-size:15.5px; color:var(--dim); line-height:1.55; max-width:46ch}
  .creds a{
    display:inline-flex; align-items:center; gap:8px; margin-top:14px; min-height:44px;
    color:var(--accent); text-decoration:none; font-size:15.5px; font-weight:650;
    border-bottom:1px solid var(--rule);
  }
  .creds a svg{width:15px;height:15px}

  footer{
    padding:22px 0 18px; border-top:2px solid var(--rule); margin-top:4px;
    font:500 11px/1.85 var(--mono); letter-spacing:.08em; text-transform:uppercase; color:var(--dim);
  }
  footer b{color:var(--ink)}

  @media (min-width:660px){
    .hero{padding:44px 0 34px}
    .groups{display:grid; grid-template-columns:1fr 1fr; gap:0 34px}
  }
</style>
