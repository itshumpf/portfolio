---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeaderPhoto from '../components/HeaderPhoto.astro';
import CsiShowcase from '../components/CsiShowcase.astro';
import About from '../components/About.astro';
import Leadership from '../components/Leadership.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';

const [profile] = await getCollection('profile');
---

<BaseLayout
  title="Braeden Keena"
  description="I build data pipelines that know when they're lying to you. 10+ years of operations leadership paired with validation-first data engineering, scrapers, and embedded RF systems."
>
  <Hero profile={profile} />
  <HeaderPhoto profile={profile} />
  <CsiShowcase />
  <Leadership />
  <About profile={profile} />
  <Projects />
  <Footer profile={profile} />
</BaseLayout>