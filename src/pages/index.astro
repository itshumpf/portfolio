---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CsiFeature from '../components/CsiFeature.astro';
import About from '../components/About.astro';
import Leadership from '../components/Leadership.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';

const [profile] = await getCollection('profile');
---

<BaseLayout
  title="Braeden Keena"
  description="I build data pipelines that know when they're lying to you. Self-taught data engineer: recurring pipelines, data integrity, and failure detection, backed by operations leadership."
>
  <Hero profile={profile} />
  <CsiFeature />
  <Projects />
  <Leadership />
  <About profile={profile} />
  <Footer profile={profile} />
</BaseLayout>
