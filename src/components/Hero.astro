---
import type { CollectionEntry } from 'astro:content';
import { navLinks } from '../lib/nav';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: CollectionEntry<'profile'>;
}

const { profile } = Astro.props;
const { name, claim, oneLiner, status, availability, email, resumeUrl, links } = profile.data;
const activeLinks = links.filter((l) => l.url);
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<section class="hero">
  <div class="wrap wrap--wide">
    <!-- Header Brand & Name -->
    <div class="hero__header">
      <div class="hero__brand-row">
        <h1 class="hero__name-title">{name.toUpperCase()}</h1>
        {(status || availability) && (
          <div class="hero__status-stack">
            {status && (
              <span class="hero__status-badge">
                <span class="hero__status-dot" aria-hidden="true" />
                {status}
              </span>
            )}
            {availability && (
              <p class="hero__availability">
                <span class="hero__availability-dot" aria-hidden="true" />
                {availability}
              </p>
            )}
          </div>
        )}
      </div>
      <p class="hero__tagline">
        Operations & Business Leader <span class="hero__divider">•</span> Self-Taught Software & Systems Builder
      </p>
    </div>

    <!-- Central Statement -->
    <div class="hero__claim-box">
      <p class="hero__claim">{claim}</p>
      <p class="hero__line">{oneLiner}</p>
    </div>

    <!-- Unmissable Dual-Lane Pathways -->
    <div class="hero__pathways">
      <!-- Lane 1: Leadership & Operations -->
      <div class="pathway-card pathway-card--leadership">
        <div class="pathway-header">
          <span class="pathway-icon">🏛️</span>
          <h2 class="pathway-title">Operations & Business Leadership</h2>
        </div>
        <p class="pathway-desc">
         I’ve led teams in places where the stakes were real — 500 acres of operations, city‑wide programs, and engineering projects that couldn’t fail.  My leadership philosophy comes from environments where excuses don’t help and clarity keeps people safe.
        </p>
        <a class="pathway-btn pathway-btn--leadership" href="/leadership">
          Explore Leadership & Business Story →
        </a>
      </div>

      <!-- Lane 2: Technical Engineering -->
      <div class="pathway-card pathway-card--engineering">
        <div class="pathway-header">
          <span class="pathway-icon">⚡</span>
          <h2 class="pathway-title">Software & Systems Engineering</h2>
        </div>
        <p class="pathway-desc">
          Built & shipped web applications, automated scraping pipelines, and federal classifiers (GAScout, GovScout, FindStorage, nacup.us) plus a WiFi-CSI RF hardware sensor array that hit 99.7% device-ID accuracy — then spent two months proving that number was measuring the room.
        </p>
        <a class="pathway-btn pathway-btn--engineering" href="#csi-project">
          Explore Technical Projects →
        </a>
      </div>
    </div>

    <!-- Quick External Links -->
    <div class="hero__footer-row">
      <div class="hero__links">
        {activeLinks.map((link) => (
          <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
        <a class="text-link" href={`mailto:${email}`}>
          Email
        </a>
        {resumeUrl && (
          <a class="text-link" href={resumeUrl} download>
            Resume (PDF)
          </a>
        )}
        <a class="text-link" href="/reviews">
          Reviews
        </a>
      </div>

    </div>
  </div>
</section>

<nav class="jumpbar" aria-label="Section navigation">
  <div class="wrap wrap--wide jumpbar__inner">
    <ul class="hero__nav-list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={link.href === path ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </div>
</nav>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 80px);
    padding-bottom: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
  }

  .hero__header {
    margin-bottom: 24px;
  }

  .hero__brand-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  h1.hero__name-title {
    font-size: clamp(2.5rem, 6.2vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-primary);
    margin: 0;
  }

  /* Pill + availability line, stacked so their dots form one column. */
  .hero__status-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .hero__status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bg-surface, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.12));
    color: var(--text-muted);
  }

  .hero__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .hero__availability {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
    /* 1px badge border + 12px badge padding-left: lines this dot up under
       the pill's dot instead of the pill's outer edge. */
    padding-left: 13px;
  }

  .hero__availability-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #10b981;
  }

  .hero__tagline {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-top: 8px;
  }

  .hero__divider {
    color: var(--text-muted);
    margin: 0 6px;
    opacity: 0.5;
  }

  .hero__claim-box {
    margin: 28px 0 36px;
    max-width: 820px;
  }

  .hero__claim {
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    line-height: 1.3;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.015em;
  }

  .hero__line {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 0;
  }

  /* Dual Pathway Cards */
  .hero__pathways {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .hero__pathways {
      grid-template-columns: 1fr;
    }
  }

  .pathway-card {
    background: var(--bg-card, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.12));
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pathway-card:hover {
    transform: translateY(-2px);
    border-color: var(--text-muted);
  }

  .pathway-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .pathway-icon {
    font-size: 1.25rem;
  }

  .pathway-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-primary);
  }

  .pathway-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .pathway-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .pathway-btn--leadership {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .pathway-btn--leadership:hover {
    background: rgba(245, 158, 11, 0.25);
    color: #ffffff;
  }

  .pathway-btn--engineering {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .pathway-btn--engineering:hover {
    background: rgba(16, 185, 129, 0.25);
    color: #ffffff;
  }

  .hero__footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.92rem;
  }

  .jumpbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
  }

  .jumpbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
  }

  /* Deliberately a solid background rather than a backdrop-filter blur:
     backdrop-filter creates a containing block for position:fixed
     descendants, and ThemeToggle carries the full-viewport party-mode
     modal. Blurring here would trap that modal inside this bar. */


  .jumpbar__inner .hero__nav-list {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .jumpbar__inner .hero__nav-list::-webkit-scrollbar {
    display: none;
  }

  .hero__nav-list {
    display: flex;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hero__nav-list a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .hero__nav-list a:hover {
    color: var(--text-primary);
  }
</style>