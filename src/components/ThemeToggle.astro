---
import '../styles/party.css';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const leadership = (await getCollection('leadership')).sort((a, b) => a.data.order - b.data.order);
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle theme (hint: double click for a surprise)"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" stroke-linecap="round" />
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" stroke-linejoin="round" />
  </svg>
</button>

<div id="party-modal" class="party-modal" hidden>
  <div class="party-modal__backdrop" data-party-close></div>
  <div class="party-modal__box" role="dialog" aria-modal="true" aria-labelledby="party-modal-title">
    <button class="party-modal__close" type="button" data-party-close aria-label="Close stat sheet">×</button>
    <header class="party-sheet__header">
      <p class="party-sheet__kicker">🎉 PARTY MODE // FULL STAT SHEET 🎉</p>
      <h2 id="party-modal-title" class="party-modal__title">The whole résumé.</h2>
      <p class="party-modal__sub">The numbers are real. The presentation has made other choices.</p>
    </header>

    <div class="party-sheet">
      <div class="party-sheet__group party-sheet__group--csi">
        <h3>📡 Room or Radio?</h3>
        <ul>
          <li><strong>69,510,186</strong><span>clean beacon frames replayed</span></li>
          <li><strong>69,688,145</strong><span>raw rows screened across 54.92 GiB</span></li>
          <li><strong>8 nights</strong><span>three beacons · two receivers</span></li>
          <li><strong>29 ideas</strong><span>carried to verdict through 35 rejection tests</span></li>
          <li><strong>13 results</strong><span>my own working results retired by controls</span></li>
          <li><strong>99.7%</strong><span>the accurate result that answered the wrong question</span></li>
          <li><strong>0</strong><span>spoof-resistance claims made without an attacker trial</span></li>
        </ul>
      </div>

      {leadership.map((entry) => (
        <div class="party-sheet__group">
          <h3>🏁 {entry.data.title}</h3>
          <ul>
            {entry.data.stats?.map((stat) => <li><strong>{stat.value}</strong><span>{stat.label}</span></li>)}
          </ul>
        </div>
      ))}

      <div class="party-sheet__group">
        <h3>🛠️ Built & shipped</h3>
        <ul>
          {projects.map((project) => {
            const firstStat = project.data.stats?.[0];
            return <li><strong>{firstStat?.value ?? project.data.status}</strong><span>{project.data.title}{firstStat ? ` — ${firstStat.label}` : ''}</span></li>;
          })}
        </ul>
      </div>

      <div class="party-sheet__group party-sheet__group--proof">
        <h3>★ Independent client proof</h3>
        <ul>
          <li><strong>100%</strong><span>Upwork Job Success</span></li>
          <li><strong>2 / 2</strong><span>completed Upwork jobs rated 5.0</span></li>
          <li><strong>$1K+</strong><span>total Upwork earnings</span></li>
          <li><strong>Rising Talent</strong><span>verified Upwork profile</span></li>
        </ul>
      </div>
    </div>

    <footer class="party-sheet__actions">
      <button id="party-enter" class="party-modal__enter" type="button">ENTER PARTY MODE 🚀</button>
      <button class="party-modal__cancel" type="button" data-party-close>return to responsible typography</button>
    </footer>
  </div>
</div>

<div id="party-marquee" class="party-marquee" hidden>
  <div class="party-marquee__track">
    <span>🎉 UNLOCKED BRAEDEN'S PARTY MODE 🎉 &nbsp; · &nbsp; 500 ACRES OF MOTOCROSS POWER &nbsp; · &nbsp; 9,915 PDF PAGES PARSED &nbsp; · &nbsp; BEST VIEWED ON A 1999 CRT MONITOR &nbsp; · &nbsp; 🦄 WELCOME TO THE INTERNET 🦄 &nbsp; · &nbsp; </span>
    <span aria-hidden="true">🎉 UNLOCKED BRAEDEN'S PARTY MODE 🎉 &nbsp; · &nbsp; 500 ACRES OF MOTOCROSS POWER &nbsp; · &nbsp; 9,915 PDF PAGES PARSED &nbsp; · &nbsp; BEST VIEWED ON A 1999 CRT MONITOR &nbsp; · &nbsp; 🦄 WELCOME TO THE INTERNET 🦄 &nbsp; · &nbsp; </span>
  </div>
</div>

<button id="party-exit" class="party-exit" type="button" hidden>✖ Exit Party Mode</button>

<button id="party-hud" class="party-hud" type="button" aria-label="Open the full stat sheet" hidden>
  <span class="party-hud__status"><i aria-hidden="true"></i> SYSTEMS UNREASONABLY ONLINE</span>
  <span><strong>69.5M</strong> FRAMES · <strong>500</strong> ACRES · <strong>2/2</strong> FIVE-STAR JOBS</span>
  <span class="party-hud__open">OPEN FULL STAT SHEET ↗</span>
</button>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const modal = document.getElementById('party-modal');
  const enterBtn = document.getElementById('party-enter');
  const exitBtn = document.getElementById('party-exit');
  const marquee = document.getElementById('party-marquee');
  const partyHud = document.getElementById('party-hud');

  function setTheme(theme: 'light' | 'dark') {
    root.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private browsing */
    }
  }

  toggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    setTheme(current === 'light' ? 'dark' : 'light');
  });

  function openModal() {
    if (modal) {
      modal.hidden = false;
      const modalBox = modal.querySelector('.party-modal__box');
      if (modalBox instanceof HTMLElement) modalBox.scrollTop = 0;
      if (enterBtn) enterBtn.textContent = root.classList.contains('party-mode') ? 'BACK TO PARTY →' : 'ENTER PARTY MODE 🚀';
      enterBtn?.focus();
    }
  }

  function closeModal() {
    if (modal) modal.hidden = true;
  }

  toggle?.addEventListener('dblclick', (event) => {
    event.preventDefault();
    if (root.classList.contains('party-mode')) openModal();
    else enterParty();
  });

  modal?.querySelectorAll('[data-party-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
  });

  const SPARKLES = ['✨', '⭐', '💖', '🌈', '💫', '🔥', '🏍️', '🏎️', '🚀', '🦄', '🌟'];
  let trailHandler: ((event: PointerEvent) => void) | null = null;

  function startCursorTrail() {
    let last = 0;
    trailHandler = (event: PointerEvent) => {
      const now = performance.now();
      if (now - last < 40) return;
      last = now;
      const el = document.createElement('span');
      el.className = 'party-sparkle';
      el.textContent = SPARKLES[Math.floor(Math.random() * SPARKLES.length)];
      el.style.left = `${event.clientX}px`;
      el.style.top = `${event.clientY}px`;
      document.body.appendChild(el);
      el.addEventListener('animationend', () => el.remove());
    };
    document.addEventListener('pointermove', trailHandler);
  }

  function stopCursorTrail() {
    if (trailHandler) document.removeEventListener('pointermove', trailHandler);
    trailHandler = null;
    document.querySelectorAll('.party-sparkle').forEach((el) => el.remove());
  }

  // Native Web Audio API 8-Bit Victory Fanfare (0 external downloads!)
  function play8BitSynthFanfare() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();
      const notes = [261.63, 329.63, 392.00, 523.25, 659.25, 783.99, 1046.50]; // C4, E4, G4, C5, E5, G5, C6
      notes.forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = freq;
        const startTime = ctx.currentTime + i * 0.07;
        const duration = i === notes.length - 1 ? 0.35 : 0.1;
        gain.gain.setValueAtTime(0.08, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(startTime);
        osc.stop(startTime + duration);
      });
    } catch {
      /* Audio context blocked or not supported */
    }
  }

  function setPartyStored(on: boolean) {
    try {
      if (on) localStorage.setItem('party', '1');
      else localStorage.removeItem('party');
    } catch {
      /* private browsing */
    }
  }

  // `silent` restores party mode on a fresh page without replaying the
  // fanfare — a chiptune on every navigation stops being a joke fast.
  function enterParty(silent = false) {
    root.classList.add('party-mode');
    if (exitBtn) exitBtn.hidden = false;
    if (marquee) marquee.hidden = false;
    if (partyHud) partyHud.hidden = false;
    startCursorTrail();
    if (!silent) {
      play8BitSynthFanfare();
      openModal();
    }
    setPartyStored(true);
  }

  function exitParty() {
    root.classList.remove('party-mode');
    if (exitBtn) exitBtn.hidden = true;
    if (marquee) marquee.hidden = true;
    if (partyHud) partyHud.hidden = true;
    stopCursorTrail();
    setPartyStored(false);
  }

  enterBtn?.addEventListener('click', () => root.classList.contains('party-mode') ? closeModal() : enterParty());
  exitBtn?.addEventListener('click', exitParty);
  partyHud?.addEventListener('click', openModal);

  // Party mode survives navigation. The cursor trail binds a pointermove
  // listener, so this waits for the DOM rather than running at parse time.
  try {
    if (localStorage.getItem('party') === '1') enterParty(true);
  } catch {
    /* private browsing */
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon {
    width: 16px;
    height: 16px;
  }

  .icon--moon {
    display: none;
  }

  :global([data-theme='light']) .icon--sun {
    display: none;
  }

  :global([data-theme='light']) .icon--moon {
    display: block;
  }

  .party-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 46px 12px 12px;
  }

  .party-modal:not([hidden]) {
    display: flex;
  }

  .party-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 0, 18, 0.28);
    backdrop-filter: blur(2px);
  }

  .party-modal__box {
    position: relative;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: 10px;
    width: min(94vw, 980px);
    max-height: min(calc(100vh - 58px), 860px);
    padding: clamp(24px, 4vw, 42px);
    text-align: left;
    overflow: auto;
    backdrop-filter: blur(5px) saturate(1.35);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .party-modal__title {
    font-weight: 700;
    font-size: clamp(1.8rem, 5vw, 3.6rem);
    letter-spacing: -0.04em;
    margin-bottom: 8px;
  }

  .party-modal__sub {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0;
  }

  .party-modal__enter {
    display: inline-block;
    padding: 12px 16px;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    margin: 0;
    transition: transform 0.1s ease, filter 0.15s ease;
  }

  .party-modal__enter:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .party-modal__cancel {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .party-exit {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 1001;
    padding: 10px 16px;
    border-radius: 999px;
    border: 2px solid #fff;
    background: #000;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  }

  .party-modal__close {
    position: absolute;
    top: 12px;
    right: 16px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 1.7rem;
    cursor: pointer;
  }

  .party-sheet__kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .party-sheet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 28px;
    border: 1px solid var(--border);
    background: var(--border);
  }

  .party-sheet__group {
    padding: clamp(18px, 3vw, 28px);
    background: var(--bg);
  }

  :global(html.party-mode) .party-modal__box {
    color: #fff;
    background:
      linear-gradient(rgba(8, 2, 28, 0.72), rgba(8, 2, 28, 0.72)) padding-box,
      linear-gradient(100deg, #ff2aa1, #ffee00 22%, #00e6ff 45%, #00ff8a 66%, #8b5cff 84%, #ff2aa1) border-box !important;
    border: 3px solid transparent !important;
    box-shadow:
      0 0 42px rgba(255, 0, 200, 0.38),
      0 0 90px rgba(0, 230, 255, 0.2),
      inset 0 0 52px rgba(139, 92, 255, 0.12) !important;
    backdrop-filter: blur(9px) saturate(1.45);
  }

  :global(html.party-mode) .party-sheet {
    background: rgba(255, 255, 255, 0.17);
    border-color: rgba(255, 255, 255, 0.22);
  }

  :global(html.party-mode) .party-sheet__group {
    background: rgba(5, 1, 22, 0.66);
  }

  :global(html.party-mode) .party-sheet__group:nth-child(3n + 2) {
    background: rgba(22, 3, 38, 0.64);
  }

  :global(html.party-mode) .party-sheet__group:nth-child(3n) {
    background: rgba(0, 21, 34, 0.62);
  }

  :global(html.party-mode) .party-modal__title,
  :global(html.party-mode) .party-sheet__group h3 {
    color: #fff !important;
    text-shadow: 0 0 15px rgba(255, 42, 161, 0.5);
  }

  :global(html.party-mode) .party-sheet__kicker {
    color: #ffee00 !important;
    text-shadow: 0 0 12px rgba(255, 238, 0, 0.55);
  }

  :global(html.party-mode) .party-modal__sub,
  :global(html.party-mode) .party-sheet__group li span {
    color: rgba(255, 255, 255, 0.86) !important;
  }

  :global(html.party-mode) .party-sheet__group li {
    border-bottom-color: rgba(255, 255, 255, 0.14);
  }

  :global(html.party-mode) .party-sheet__group li strong {
    color: #43f4e0 !important;
    text-shadow: 0 0 10px rgba(0, 230, 255, 0.45);
  }

  :global(html.party-mode) .party-sheet__group:nth-child(3n + 2) li strong {
    color: #ffee70 !important;
  }

  :global(html.party-mode) .party-sheet__group:nth-child(3n) li strong {
    color: #ff72c1 !important;
  }

  :global(html.party-mode) .party-modal__close,
  :global(html.party-mode) .party-modal__cancel {
    color: rgba(255, 255, 255, 0.82) !important;
  }

  .party-sheet__group--csi,
  .party-sheet__group--proof {
    grid-column: 1 / -1;
  }

  .party-sheet__group h3 {
    margin-bottom: 14px;
    font-size: 0.92rem;
  }

  .party-sheet__group ul {
    display: grid;
    gap: 9px;
  }

  .party-sheet__group--csi ul,
  .party-sheet__group--proof ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
  }

  .party-sheet__group li {
    display: grid;
    grid-template-columns: minmax(76px, auto) 1fr;
    gap: 11px;
    align-items: baseline;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--border-soft);
  }

  .party-sheet__group li strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .party-sheet__group li span {
    color: var(--text-secondary);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .party-sheet__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
  }

  .party-hud {
    display: none;
  }

  .party-hud:not([hidden]) {
    display: grid;
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 1001;
    gap: 4px;
    min-width: 290px;
    padding: 12px 14px;
    border: 2px solid #00ffb7;
    background: rgba(3, 3, 16, 0.9);
    box-shadow: 5px 5px 0 #ff00aa, -3px -3px 0 #ffee00;
    color: #fff;
    font-family: 'Cascadia Code', monospace !important;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
    transform: rotate(-1deg);
    cursor: pointer;
    text-align: left;
  }

  .party-hud strong {
    color: #ffee00;
  }

  .party-hud__status {
    margin-bottom: 5px;
    color: #00ffb7;
    font-weight: 800;
  }

  .party-hud__open {
    margin-top: 3px;
    color: #fff;
    font-weight: 800;
  }

  .party-hud__status i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 50%;
    background: #00ffb7;
    box-shadow: 0 0 10px #00ffb7;
    animation: party-blink 0.8s steps(1) infinite;
  }

  @media (max-width: 560px) {
    .party-hud:not([hidden]) {
      left: 8px;
      bottom: 8px;
      min-width: 0;
      grid-template-columns: 1fr;
    }

    .party-hud__status {
      grid-column: 1;
    }

    .party-sheet { grid-template-columns: 1fr; }
    .party-sheet__group--csi, .party-sheet__group--proof { grid-column: 1; }
    .party-sheet__group--csi ul, .party-sheet__group--proof ul { grid-template-columns: 1fr; }
    .party-sheet__actions { align-items: stretch; flex-direction: column; }
    .party-modal__enter { width: 100%; }
  }
</style>
