---
import { getCollection } from 'astro:content';
import { clientProof } from '../lib/clientProof';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const statusLabel: Record<string, string> = {
  live: 'Live', sunset: 'Sunset', wip: 'In progress', delivered: 'Delivered',
};
---

<section id="work" class="work">
  <div class="wrap wrap--wide">
    <div class="work__head section-head">
      <div>
        <p class="eyebrow">Other work</p>
        <h2 class="section-title">Selected work.</h2>
      </div>
    </div>

    <div class="project-grid">
      {projects.map((project, index) => {
        const d = project.data;
        const firstStat = d.stats?.[0];
        const proof = clientProof[project.id];
        return (
          <article class="project-card">
            <div class="project-card__index">{String(index + 1).padStart(2, '0')}</div>
            <div class="project-card__meta">
              <span>{statusLabel[d.status]}</span>
              <span>{d.period}</span>
              {d.kind === 'client' && <span>Client</span>}
            </div>
            <h3>{d.title}</h3>
            <p class="project-card__copy">{d.tagline}</p>
            {firstStat && (
              <p class="project-card__stat">
                <strong>{firstStat.value}</strong>
                <span>{firstStat.label}</span>
              </p>
            )}
            {proof && (
              <blockquote class="project-card__review">
                <span aria-label={`${proof.rating.toFixed(1)} out of 5 stars`}>★★★★★</span>
                <p>“{proof.quote}”</p>
                <cite>Upwork client · {proof.rating.toFixed(1)}</cite>
              </blockquote>
            )}
            <div class="project-card__footer">
              <p>{d.tech.slice(0, 3).join(' · ')}</p>
              <a href={`/work/${project.id}`}>Read case study <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: clamp(78px, 11vw, 132px);
    border-bottom: 1px solid var(--border);
  }

  .work__head {
    display: grid;
    margin-bottom: 52px;
  }

  .work__head h2 {
    margin-top: 12px;
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.052em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .project-card {
    position: relative;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 4vw, 38px);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .project-card__index {
    position: absolute;
    top: 30px;
    right: 32px;
    color: var(--border);
    font-family: var(--font-mono);
    font-size: 2.1rem;
  }

  .project-card__meta {
    display: flex;
    gap: 12px;
    margin-bottom: 42px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-card__meta span + span::before {
    content: '·';
    margin-right: 12px;
  }

  .project-card h3 {
    max-width: 18ch;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.035em;
  }

  .project-card__copy {
    max-width: 54ch;
    margin-top: 14px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .project-card__stat {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: baseline;
    margin-top: 25px;
  }

  .project-card__stat strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.2rem;
  }

  .project-card__stat span {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .project-card__review {
    margin: 24px 0 0;
    padding: 17px 0 0;
    border-top: 1px solid var(--border-soft);
  }

  .project-card__review > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .project-card__review p {
    margin-top: 7px;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .project-card__review cite {
    display: block;
    margin-top: 7px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-style: normal;
  }

  .project-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-top: auto;
    padding-top: 34px;
  }

  .project-card__footer p {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .project-card__footer a {
    flex: 0 0 auto;
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
  }

  .project-card__footer a:hover { color: var(--accent); }

  @media (max-width: 760px) {
    .project-grid { grid-template-columns: 1fr; }
    .project-card { min-height: 340px; }
  }
</style>
