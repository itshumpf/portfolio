---
import { getCollection, render } from 'astro:content';
import CaseImage from './CaseImage.astro';
import Testimonial from './Testimonial.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: project.data.expandedBody ? (await render(project)).Content : null,
  })),
);

const statusLabel: Record<string, string> = {
  live: 'Live',
  sunset: 'Sunset',
  wip: 'In progress',
  delivered: 'Delivered',
};
---

<section id="work">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Other work</p>
      <h2 class="section-title">Selected work.</h2>
    </div>

    <nav class="project-index" aria-label="Jump to a project">
      <ol class="project-index__list">
        {
          rendered.map(({ project }) => {
            const d = project.data;
            return (
              <li>
                <a class="project-index__link" href={`#project-${project.id}`}>
                  <span class="project-index__title">{d.title}</span>
                  {d.indexLabel && <span class="project-index__desc">{d.indexLabel}</span>}
                </a>
              </li>
            );
          })
        }
      </ol>
    </nav>

    <div class="project-list">
      {
        rendered.map(({ project, Content }) => {
          const d = project.data;
          const hasLink = Boolean(d.links.live || d.links.repo);
          return (
            <article class="project" id={`project-${project.id}`}>
              <div class="project__head">
                <h3 class="project__title">
                  {d.title}
                  {d.kind === 'client' && <span class="project__badge">Client engagement</span>}
                </h3>
                <span class="project__meta">
                  {statusLabel[d.status]} · {d.period}
                </span>
              </div>

              {d.thesis && <p class="project__thesis">{d.thesis}</p>}

              {d.stats && (
                <div class="stat-row project__stats">
                  {d.stats.map((stat) => (
                    <div class="stat">
                      <span class="stat-value">{stat.value}</span>
                      <span class="stat-label">{stat.label}</span>
                    </div>
                  ))}
                </div>
              )}

              {d.testimonial && (
                <div class="project__testimonial">
                  <Testimonial
                    quote={d.testimonial.quote}
                    attribution={d.testimonial.attribution}
                    rating={d.testimonial.rating}
                    sourceUrl={d.testimonial.sourceUrl}
                    sourceLabel={d.testimonial.sourceLabel}
                    note={d.testimonial.note}
                  />
                </div>
              )}

              {Content ? (
                <div class="project__body">
                  <Content />
                </div>
              ) : (
                <p class="project__tagline">{d.tagline}</p>
              )}

              {d.screenshots && d.screenshots.length > 0 && (
                <div class="project__shots">
                  {d.screenshots.map((shot) => (
                    <CaseImage image={shot} />
                  ))}
                </div>
              )}

              {d.impact && (
                <p class="project__impact">
                  <span class="project__impact-label">Why it matters</span>
                  {d.impact}
                </p>
              )}

              <p class="tag-list project__tech">{d.tech.join(' · ')}</p>

              {(hasLink || d.links.noLinkNote) && (
                <p class="project__links">
                  {d.links.live && (
                    <a class="text-link" href={d.links.live} target="_blank" rel="noopener noreferrer">
                      Live: {d.links.live.replace(/^https?:\/\//, '')}
                    </a>
                  )}
                  {d.links.repo && (
                    <a class="text-link" href={d.links.repo} target="_blank" rel="noopener noreferrer">
                      Code: {d.links.repo.replace(/^https?:\/\//, '')}
                    </a>
                  )}
                  {!hasLink && d.links.noLinkNote && (
                    <span class="project__no-link">{d.links.noLinkNote}</span>
                  )}
                </p>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-index {
    margin-bottom: clamp(28px, 5vw, 44px);
  }

  .project-index__list {
    display: grid;
  }

  .project-index__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding-block: 7px;
    text-decoration: none;
    border-bottom: 1px solid var(--border-soft);
  }

  .project-index__list li:first-child .project-index__link {
    border-top: 1px solid var(--border-soft);
  }

  .project-index__title {
    color: var(--text-secondary);
    font-size: 0.92rem;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .project-index__link:hover .project-index__title {
    color: var(--text-primary);
    text-decoration-color: var(--accent);
  }

  .project-index__desc {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .project-list {
    display: grid;
    gap: 0;
  }

  .project {
    padding-block: 28px;
    border-top: 1px solid var(--border-soft);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border-soft);
  }

  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .project__title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 1.05rem;
  }

  .project__badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 9px;
    letter-spacing: 0.01em;
  }

  .project__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .project__thesis {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    max-width: 66ch;
    margin-bottom: 16px;
  }

  .project__stats {
    margin-bottom: 20px;
  }

  .project__testimonial {
    margin-bottom: 20px;
  }

  .project__tagline {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 62ch;
    margin-bottom: 12px;
  }

  .project__body {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 68ch;
  }

  .project__body :global(p) {
    margin-bottom: 12px;
  }

  .project__body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Screenshots sit between the prose and the tech list. Single column so
     wide captures stay legible — side by side they'd shrink below the point
     where the pricing tables can be read. */
  .project__shots {
    display: grid;
    gap: 16px;
    margin-block: 18px;
    max-width: 68ch;
  }

  .project__impact {
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin-top: 16px;
    margin-bottom: 16px;
    padding-left: 16px;
    border-left: 2px solid var(--border-soft);
  }

  .project__impact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .project__tech {
    margin-bottom: 12px;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .project__no-link {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-style: italic;
  }
</style>
